# 이 파일을 ".env" 라는 이름으로 복사한 뒤 키를 넣어 주세요.
ANTHROPIC_API_KEY=여기에_API_키를_붙여넣기

# --- 아래는 필요할 때만 바꾸세요 (앞의 # 를 지우면 적용) ---
# 문제를 푸는 Claude 모델
# CLAUDE_MODEL=claude-sonnet-5-5

# 음성 인식 모델 크기: tiny / base / small / medium / large-v3
# 클수록 정확하지만 느리고 용량이 커요. 한국어는 small 이상 권장, 정확도가 아쉬우면 medium.
# WHISPER_MODEL=small
